{"continue":{"iistart":"2012-12-02T10:30:24Z","continue":"||"},"query":{"pages":{"3241421":{"pageid":3241421,"ns":6,"title":"File:Ballet de la nuit 1653.jpg","imagerepository":"local","imageinfo":[{"size":354237,"width":1020,"height":1566,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/thumb/0/06/Ballet_de_la_nuit_1653.jpg/960px-Ballet_de_la_nuit_1653.jpg","thumbwidth":640,"thumbheight":983,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/0/06/Ballet_de_la_nuit_1653.jpg"},"url":"https://upload.wikimedia.org/wikipedia/commons/0/06/Ballet_de_la_nuit_1653.jpg","descriptionurl":"https://commons.wikimedia.org/wiki/File:Ballet_de_la_nuit_1653.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=3241421","extmetadata":{"DateTime":{"value":"2023-08-22 14:26:25","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"<div class=\"fn\">\n<div style=\"font-size:0.9em;display:inline-block;\">French:  <div style=\"display:inline-block\" dir=\"ltr\" lang=\"fr\"><i>Louis XIV dans Le Ballet de la nuit</i></div></div><div style=\"display: none;\">title QS:P1476,fr:\"Louis XIV dans Le Ballet de la nuit\"</div><div style=\"display: none;\">label QS:Lfr,\"Louis XIV dans Le Ballet de la nuit\"</div></div>","source":"commons-desc-page"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"1653 paintings|Ballet Royal de la Nuit|Sun in art|Artworks without Wikidata item|PD-old-100-expired|PD-Art (PD-old-100-expired)|PD-Art (PD-old)|Standing men in art|CC-PD-Mark|Feathered headdresses in art (male)|People with feathers|Drawings of ballet|Drawings of Apollo|Louis XIV of France in drawings|Feathers in art|Male dancers in art","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"Artist":{"value":"<bdi><a href=\"https://en.wikipedia.org/wiki/en:Henri_de_Gissey\" class=\"extiw\" title=\"w:en:Henri de Gissey\"><span title=\"French artist (1621-1673)\">Henri de Gissey</span></a></bdi>","source":"commons-desc-page"},"ImageDescription":{"value":"Louis XIV dans <i><a rel=\"nofollow\" class=\"external text\" href=\"http://operabaroque.fr/CAMBEFORT_NUIT.htm\">Le Ballet de la nuit</a></i>. The ballet was choreographed in 1653. It was significant because Louis XIV made his debut at court. This court ballet lasted 12 hours, beginning at sundown and lasting until morning, and consisted of 45 dances. Louis XIV appeared in 5 of them. The most famous dance of Ballet de la Nuit portrays Louis XIV as Apollo the Sun King. Art by <a href=\"https://en.wikipedia.org/wiki/Henri_de_Gissey\" class=\"extiw\" title=\"w:Henri de Gissey\">Henri de Gissey</a> published in copy of the ballet by R. Ballard in 1653","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1653<div style=\"display: none;\">date QS:P571,+1653-00-00T00:00:00Z/9</div>","source":"commons-desc-page"},"Credit":{"value":"<cite class=\"book\" style=\"font-style:normal\">Christout, Marie-Fran\u00e7oise (1987)      <i> Le ballet de cour au XVIIe si\u00e8cle</i>, <a href=\"https://en.wikipedia.org/wiki/en:Geneva\" class=\"extiw\" title=\"w:en:Geneva\"><span title=\"city and political municipality, as well as capital of the canton of the same name in Switzerland\">Geneva</span></a>:  Minkoff  <small></small></cite>","source":"commons-desc-page"},"Permission":{"value":"Public Domain","source":"commons-desc-page","hidden":""},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]}}}}