{"continue":{"iistart":"2008-11-27T01:09:21Z","continue":"||"},"query":{"pages":{"5289781":{"pageid":5289781,"ns":6,"title":"File:Jazz ensemble - seating diagram.svg","imagerepository":"local","imageinfo":[{"size":105510,"width":1300,"height":600,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fa/Jazz_ensemble_-_seating_diagram.svg/960px-Jazz_ensemble_-_seating_diagram.svg.png","thumbwidth":640,"thumbheight":295,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fa/Jazz_ensemble_-_seating_diagram.svg/1280px-Jazz_ensemble_-_seating_diagram.svg.png"},"url":"https://upload.wikimedia.org/wikipedia/commons/f/fa/Jazz_ensemble_-_seating_diagram.svg","descriptionurl":"https://commons.wikimedia.org/wiki/File:Jazz_ensemble_-_seating_diagram.svg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=5289781","extmetadata":{"DateTime":{"value":"2024-12-16 12:19:44","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Jazz ensemble - seating diagram","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Big bands|Jazz ensembles|Seating plans|Self-published work|Structure diagrams|Unspec SVG created with Inkscape|2008 diagrams|Diagrams labelled with numbers only|Unspec New SVG created with Inkscape|SVG music","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Diagram showing a typical seating arrangement for members of a <a href=\"https://en.wikipedia.org/wiki/jazz_ensemble\" class=\"extiw\" title=\"w:jazz ensemble\">jazz ensemble</a>.\nOn the left, the <a href=\"https://en.wikipedia.org/wiki/rhythm_section\" class=\"extiw\" title=\"w:rhythm section\">rhythm section</a> consists of <a href=\"https://en.wikipedia.org/wiki/drum_set\" class=\"extiw\" title=\"w:drum set\">drum set</a>, <a href=\"https://en.wikipedia.org/wiki/Electronic_keyboard\" class=\"extiw\" title=\"w:Electronic keyboard\">keyboard</a>/<a href=\"https://en.wikipedia.org/wiki/piano\" class=\"extiw\" title=\"w:piano\">piano</a>, <a href=\"https://en.wikipedia.org/wiki/electric_guitar\" class=\"extiw\" title=\"w:electric guitar\">electric guitar</a>, and <a href=\"https://en.wikipedia.org/wiki/bass_guitar\" class=\"extiw\" title=\"w:bass guitar\">bass guitar</a>.  On the right are the horns.  The <a href=\"https://en.wikipedia.org/wiki/trumpet\" class=\"extiw\" title=\"w:trumpet\">trumpets</a> are in the back row, with first trumpet sometimes doubling on <a href=\"https://en.wikipedia.org/wiki/piccolo_trumpet\" class=\"extiw\" title=\"w:piccolo trumpet\">piccolo trumpet</a>, and second trumpet sometimes doubling on <a href=\"https://en.wikipedia.org/wiki/flugelhorn\" class=\"extiw\" title=\"w:flugelhorn\">flugelhorn</a>.  In the next row are the <a href=\"https://en.wikipedia.org/wiki/trombone\" class=\"extiw\" title=\"w:trombone\">trombones</a>; sometimes the fourth trombone is a <a href=\"https://en.wikipedia.org/wiki/bass_trombone\" class=\"extiw\" title=\"w:bass trombone\">bass trombone</a>.  In the front row are the <a href=\"https://en.wikipedia.org/wiki/saxophone\" class=\"extiw\" title=\"w:saxophone\">saxophones</a>; from left to right are <a href=\"https://en.wikipedia.org/wiki/tenor_saxophone\" class=\"extiw\" title=\"w:tenor saxophone\">Tenor</a> I, <a href=\"https://en.wikipedia.org/wiki/alto_saxophone\" class=\"extiw\" title=\"w:alto saxophone\">Alto</a> II, Alto I, Tenor II, and <a href=\"https://en.wikipedia.org/wiki/baritone_saxophone\" class=\"extiw\" title=\"w:baritone saxophone\">Baritone</a>.  The tenors and altos sometimes double on other woodwinds -- <a href=\"https://en.wikipedia.org/wiki/soprano_saxophone\" class=\"extiw\" title=\"w:soprano saxophone\">soprano saxophone</a>, <a href=\"https://en.wikipedia.org/wiki/clarinet\" class=\"extiw\" title=\"w:clarinet\">clarinet</a>, and/or <a href=\"https://en.wikipedia.org/wiki/flute\" class=\"extiw\" title=\"w:flute\">flute</a>.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2008-11-26","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"Matthew D. Wilson (<a href=\"//commons.wikimedia.org/wiki/User:LtPowers\" title=\"User:LtPowers\">LtPowers</a>)","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 3.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 3.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/3.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-3.0","source":"commons-templates","hidden":""}}}]}}}}