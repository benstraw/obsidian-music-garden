{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benstrawbridge.com/schemas/music-garden/public/v1/week.schema.json",
  "title": "Music Garden public-v1 weekly aggregate",
  "type": "object",
  "required": ["weekStart", "weekEnd", "total_plays", "unique_tracks", "unique_artists", "unique_albums", "total_minutes"],
  "properties": {
    "weekStart": { "type": "string", "format": "date" },
    "weekEnd": { "type": "string", "format": "date" },
    "total_plays": { "type": "integer", "minimum": 0 },
    "unique_tracks": { "type": "integer", "minimum": 0 },
    "unique_artists": { "type": "integer", "minimum": 0 },
    "unique_albums": { "type": "integer", "minimum": 0 },
    "total_minutes": { "type": "integer", "minimum": 0 }
  }
}
